# Dockerfile.astrbot — v0.2.0 AstrBot image with the anime_tracking plugin.
#
# This image extends the official AstrBot image and pre-installs the
# anime_tracking plugin. For the official AstrBot image reference see
# https://github.com/Soulter/AstrBot
#
# If the upstream AstrBot image is not available at build time, mount
# astrbot_plugin_anime_tracking/ as a volume instead (compose.yaml
# fallback).

FROM soulter/astrbot:latest

# Copy the plugin so AstrBot discovers it at startup.
COPY astrbot_plugin_anime_tracking/ /app/plugin/astrbot_plugin_anime_tracking/

# Copy Anime Core source and migrations so the plugin can import them.
COPY src/ /app/src/
COPY migrations/ /app/migrations/
COPY alembic.ini /app/
COPY pyproject.toml /app/

ENV PYTHONPATH=/app
